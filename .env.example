# Google Workspace OAuth. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional hard restriction, e.g. example.com
GOOGLE_WORKSPACE_ALLOWED_DOMAIN=

# Provider controls. Live display remains blocked until source, parity and display gates all opt in.
OPS_TASK_SOURCE=mock-read-only
OPS_ALLOW_LIVE_TASK_DISPLAY=false
# Set true only after a successful documented live parity check.
OPS_TASK_PARITY_APPROVED=false

# Transitional owner mapping until the User entity is connected to Workspace identity.
OPS_CURRENT_USER_NAME=Max Meisner
